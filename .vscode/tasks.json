{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Démarrer Serveur Test (Node)",
      "type": "shell",
      "command": "npm run test:server",
      "options": {
        "cwd": "${workspaceFolder}/server" // Ajuste le chemin si ton dossier serveur a un autre nom
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(Server running|Dashboard disponible).*" // Aligné sur les logs de ton serveur
        }
      },
      "presentation": {
        "group": "streetphare-test",
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}