{
  "name": "streetphare-server",
  "version": "3.0.0",
  "description": "StreetPhare — Infrastructure serveur Node.js (Primary + Backup)",
  "main": "src/primary.js",
  "scripts": {
    "start:primary": "cross-env SERVER_TYPE=PRIMARY node src/primary.js",
    "start:backup": "cross-env SERVER_TYPE=BACKUP node src/backup.js",
    "dev:primary": "cross-env SERVER_TYPE=PRIMARY nodemon src/primary.js",
    "dev:backup": "cross-env SERVER_TYPE=BACKUP nodemon src/backup.js",
    "build:primary": "node scripts/build-sea.js primary",
    "build:backup": "node scripts/build-sea.js backup",
    "build:all": "node scripts/build-sea.js primary && node scripts/build-sea.js backup",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save"
  },
  "bin": {
    "streetphare-primary": "src/primary.js",
    "streetphare-backup": "src/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.5.0",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.3",
    "uuid": "^14.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.0",
    "pm2": "^7.0.4"
  }
}
