# StreetPhare — Configuration serveur
# Copié depuis .env.example — adaptez les valeurs.

# Rôle du serveur : PRIMARY ou BACKUP
SERVER_TYPE=PRIMARY

# Adresse IP / domaine de ce serveur
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Backup (port dédié pour le serveur secondaire)
BACKUP_HOST=127.0.0.1
BACKUP_PORT=3001

# URL du serveur partenaire
# En production, les deux serveurs tournent sur la même machine
# derrière Caddy et communiquent en HTTP local (127.0.0.1).
PARTNER_URL=http://127.0.0.1:3001

# Clé secrète pour le chiffrement AES-256-CBC
MASTER_KEY=streetphare-dev-key-change-in-production

# Secret JWT
JWT_SECRET=streetphare-jwt-secret-change-in-production

# Hash bcrypt de admin123 (12 rounds)
ADMIN_HASH=$2a$12$AfHdvFUjX2V3Yf4x6wjuG.c.P3CrQ4q6bsn83sHbxQK2h6Qc3qWse

JWT_EXPIRES_IN=8h

ADMIN_USERNAME=admin

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

CONSENSUS_THRESHOLD=3
SYNC_INTERVAL_SECONDS=30
LOG_DIR=./logs