# StreetPhare v3.3.2 — Reverse-proxy Caddy (TLS automatique Let's Encrypt)

streetphare.ddns.net {
	tls {
		protocols tls1.2 tls1.3
		reverse_proxy localhost:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# ── Chemin WebSocket /mesh ─────────────────────────────────────────
	handle /mesh* {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up Origin {host}

			# Flush immédiat pour le streaming WebSocket WAN (évite le code 1006)
			flush_interval -1

			transport http {
				dial_timeout 10s
			}
		}
	}

	# ── Toutes les autres routes (API REST, admin, etc.) ───────────────
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	log {
		output file /var/log/caddy/streetphare-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

streetphare.ddns.net:4000 {
	tls {
		protocols tls1.2 tls1.3
	}

	reverse_proxy 127.0.0.1:4000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/streetphare-admin-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
