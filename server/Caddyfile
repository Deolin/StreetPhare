# StreetPhare v3.3.3 — Reverse-proxy Caddy (TLS automatique Let's Encrypt)
#
# ── PRÉREQUIS RÉSEAU (Let's Encrypt / ACME) ──────────────────────────
# Caddy a IMPÉRATIVEMENT besoin des ports 80 (challenge HTTP-01) et 443
# (HTTPS) ouverts et redirigés vers ce serveur (routeur : redirection de
# port 80→80 et 443→443). Sans le port 80 accessible publiquement, le
# challenge HTTP-01 échoue et Caddy sert un certificat auto-signé →
# erreur `net::ERR_CERT_AUTHORITY_INVALID` dans le navigateur.
{
	# Adresse de contact ACME (Let's Encrypt).
	# ⚠️ OBLIGATOIRE en production : remplacez `admin@streetphare.local`
	#    par une VRAIE adresse e-mail valide. Sans cela, Let's Encrypt ne
	#    peut pas vous notifier (expiration / renouvellement imminent) et
	#    applique des rate-limits plus stricts.
	email admin@streetphare.local
}

# ── MODE DÉVELOPPEMENT (sans ports 80/443 publics) ───────────────────
# Si vous testez en local sans port 80/443 exposé, Caddy ne peut pas
# obtenir de certificat Let's Encrypt. Deux options :
#   1. Remplacer `tls { protocols tls1.2 tls1.3 }` par `tls internal`
#      (certificat auto-signé géré par Caddy, sans dépendance ACME).
#   2. RETIRER l'en-tête `Strict-Transport-Security` (HSTS) ci-dessous
#      pour ne pas enfermer le navigateur en HTTPS forcé.
# Pour purger le HSTS déjà enregistré par le navigateur sur un domaine
# de test :
#   Chrome/Edge : chrome://net-internals/#hsts → « Delete domain security policies »
#   Firefox     : effacez l'historique complet (cookies + site)

# ── NETTOYAGE DU STOCKAGE Caddy (certificat corrompu) ────────────────
# Les données ACME sont stockées par défaut dans :
#   /var/lib/caddy/.local/share/caddy   (ou $XDG_DATA_HOME/caddy)
# Pour forcer un renouvellement propre après corruption :
#   sudo systemctl stop caddy
#   sudo rm -rf /var/lib/caddy/.local/share/caddy/certificates
#   sudo systemctl start caddy

streetphare.ddns.net {
	reverse_proxy 127.0.0.1:3000
	tls {
		protocols tls1.2 tls1.3
	}

	header {
		# HSTS : force HTTPS pour 1 an (31536000 s) + preload.
		# ⚠️ En mode développement/local (certificat auto-signé `tls internal`),
		#    commentez cette ligne pour éviter de bloquer le navigateur.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# ── Chemin WebSocket /mesh ─────────────────────────────────────────
	handle /mesh* {
		reverse_proxy 127.0.0.1:3000 {
			# FIX v3.3.3 : header_up Host {host} nécessaire pour que le
			# handshake WebSocket RFC 6455 aboutisse. Les clients mobiles
			# Dart n'envoient pas toujours l'en-tête Host, Caddy le
			# normalise via {host} avant de le transmettre à Node.js.
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			# FIX v3.3.4 : Transmettre l'Origin du client mobile pour que
			# Node.js (CORS + WebSocket) voie l'origine réelle. Sans cela,
			# Node.js reçoit Origin: N/A → code 1006 Abnormal Closure.
			header_up Origin {header.origin}
			# Forcer la transmission explicite des en-têtes de handshake
			# WebSocket (Upgrade + Connection) pour garantir la compatibilité
			# RFC 6455 avec les clients Dart/dart:io.
			header_up Upgrade {header.upgrade}
			header_up Connection {header.connection}

			transport http {
				dial_timeout 10s
			}
		}
	}

	# ── Chemin WebSocket /admin-ws (dashboard administrateur) ───────────
	handle /admin-ws* {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up Origin {header.origin}
			# FIX admin : transférer explicitement le handshake WebSocket
			# (Upgrade + Connection) pour le dashboard admin, comme pour /mesh.
			# Sans cela, la connexion WebSocket du panneau admin peut échouer
			# (code 1006) et forcer une boucle de reconnexion de l'invite.
			header_up Upgrade {header.upgrade}
			header_up Connection {header.connection}

			transport http {
				dial_timeout 10s
			}
		}
	}

	# ── Toutes les autres routes (API REST, admin, etc.) ───────────────
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up Origin {header.origin}
		}
	}

	log {
		output file /var/log/caddy/streetphare-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# ── Port 3001 — Serveur Backup (HTTP local, exposé en HTTPS par Caddy) ──
# Le serveur Backup écoute sur 127.0.0.1:3001. Caddy l'expose en HTTPS
# sur le port 443 du même domaine pour que les clients mobiles externes
# puissent basculer sur le backup sans devoir spécifier un port explicite.
# Le FailoverManager du client utilise la même URL de base HTTPS et
# route vers le backup via ce bloc Caddy.
streetphare.ddns.net:3001 {
	tls {
		protocols tls1.2 tls1.3
	}

	reverse_proxy 127.0.0.1:3001 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up Origin {header.origin}
	}

	log {
		output file /var/log/caddy/streetphare-backup-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

streetphare.ddns.net:4000 {
	tls {
		protocols tls1.2 tls1.3
	}

	reverse_proxy 127.0.0.1:4000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up Origin {header.origin}
	}

	log {
		output file /var/log/caddy/streetphare-admin-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
