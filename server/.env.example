# StreetPhare — Configuration serveur
# Copiez ce fichier en '.env' et adaptez les valeurs.

# Rôle du serveur : PRIMARY ou BACKUP
SERVER_TYPE=PRIMARY

# Adresse IP / domaine de ce serveur
# En production avec Caddy, utiliser 127.0.0.1 (localhost) pour empêcher
# tout accès direct depuis l'extérieur (seul Caddy écoute sur l'IP publique).
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# URL du serveur partenaire
#   - Si PRIMARY   → URL du BACKUP  (ex: http://127.0.0.1:3001)
#   - Si BACKUP    → URL du PRIMARY (ex: http://127.0.0.1:3000)
#   En production, les deux serveurs tournent sur la même machine
#   derrière Caddy et communiquent en HTTP local.
PARTNER_URL=http://127.0.0.1:3001

# Clé secrète pour le chiffrement AES-256-CBC (doit être identique sur les deux serveurs)
# En production, générez une clé forte : export MASTER_KEY="$(openssl rand -hex 32)"
MASTER_KEY=streetphare-dev-key-change-in-production

# ── Authentification Admin (JWT + RBAC) ──────────────────────────────────
# Secret pour la signature des tokens JWT (HS256). Minimum 32 caractères.
# Génération : export JWT_SECRET="$(openssl rand -hex 32)"
JWT_SECRET=streetphare-jwt-secret-change-in-production

# Hash bcrypt du mot de passe administrateur (12 rounds de salage).
# Génération : node -e "require('bcryptjs').hash('votre-motdepasse', 12).then(h => console.log(h))"
ADMIN_HASH=$2a$12$AfHdvFUjX2V3Yf4x6wjuG.c.P3CrQ4q6bsn83sHbxQK2h6Qc3qWse

# Durée de validité des tokens JWT (ex: 8h, 24h, 7d).
JWT_EXPIRES_IN=8h

# ── Authentification Admin : Credentials du dashboard web ────────────────
# Identifiant affiché dans le formulaire de connexion du dashboard.
ADMIN_USERNAME=admin

# ── Rate Limiting ────────────────────────────────────────────────────────
# Fenêtre de rate limiting pour les routes publiques (ms).
RATE_LIMIT_WINDOW_MS=900000
# Nombre max de requêtes par IP dans la fenêtre.
RATE_LIMIT_MAX=500

# Seuil de votes pour validation d'un signalement (consensus)
CONSENSUS_THRESHOLD=3

# Intervalle de synchronisation (secondes)
SYNC_INTERVAL_SECONDS=30

# Dossier pour les logs
LOG_DIR=./logs